  "SYR": {
    "bullets": [
      {
        "label": "Recovery and sanctions",
        "text": "Presented Syria as moving from conflict toward reconstruction and renewed diplomacy. Said the Caesar Act had been repealed, sanctions lifted, and Syria removed from the state-sponsors-of-terrorism list.",
        "evidence": [
          {
            "sentence_id": "S022",
            "quote": "Ladies and gentlemen, in our journey in the struggle between good and evil, the bloodshed was stopped and destruction was stopped."
          },
          {
            "sentence_id": "S023",
            "quote": "Syria started the journey of reconstruction and recovery."
          },
          {
            "sentence_id": "S024",
            "quote": "The country was united."
          },
          {
            "sentence_id": "S025",
            "quote": "We controlled arms."
          },
          {
            "sentence_id": "S026",
            "quote": "We rebuilt military and civilian institutions."
          },
          {
            "sentence_id": "S027",
            "quote": "Sanctions were lifted."
          },
          {
            "sentence_id": "S028",
            "quote": "Reconstruction projects have continued."
          },
          {
            "sentence_id": "S029",
            "quote": "We have combated drug trafficking, and we focused on transitional justice."
          },
          {
            "sentence_id": "S030",
            "quote": "We have ascertained the fate of the missing."
          },
          {
            "sentence_id": "S031",
            "quote": "We turned our vision into practical action."
          },
          {
            "sentence_id": "S032",
            "quote": "We have forged partnerships, and we focused mainly on the future and on the welfare of our people."
          },
          {
            "sentence_id": "S033",
            "quote": "We focused on reconstruction."
          },
          {
            "sentence_id": "S034",
            "quote": "We relied on the free will of our people and our independence."
          },
          {
            "sentence_id": "S035",
            "quote": "This national vision relied on diplomatic efforts."
          },
          {
            "sentence_id": "S036",
            "quote": "Since liberation, more than 100 states started communicating with us through 4,000 communications."
          },
          {
            "sentence_id": "S037",
            "quote": "Our capital has hosted more than 60 diplomatic missions."
          },
          {
            "sentence_id": "S038",
            "quote": "Syria has restored its status in the international community."
          },
          {
            "sentence_id": "S048",
            "quote": "The Caesar Act was repealed."
          },
          {
            "sentence_id": "S049",
            "quote": "Sanctions were lifted and culminated in cooperation with the European Union."
          },
          {
            "sentence_id": "S050",
            "quote": "We are no longer part of the list of state sponsors of terrorism."
          }
        ]
      },
      {
        "label": "Returns and security",
        "text": "Reported the return of 3.5 million refugees and internally displaced people, promoted a “Syria Without Refugee Camps” initiative, and described action against Captagon and organized crime. Highlighted cooperation with the OPCW, IAEA, and partner states on weapons-related obligations.",
        "evidence": [
          {
            "sentence_id": "S041",
            "quote": "With seven states, we started a group, the Breath of Freedom, to destroy the chemical weapons file."
          },
          {
            "sentence_id": "S042",
            "quote": "We have been working with the OPCW, and we are working with the IAEA with transparency, as we believe that collective security is our duty."
          },
          {
            "sentence_id": "S043",
            "quote": "The strict implementation of our treaties spares our world the horrors of chemical weapons and nuclear weapons."
          },
          {
            "sentence_id": "S044",
            "quote": "We combated transnational crime."
          },
          {
            "sentence_id": "S045",
            "quote": "We have seized large amounts of Captagon, and we combated human smuggling and organized crime."
          },
          {
            "sentence_id": "S056",
            "quote": "Three and a half million refugees and IDPs have returned in a safe and decent way."
          },
          {
            "sentence_id": "S057",
            "quote": "Syria turned from a crisis into an opportunity for many countries."
          },
          {
            "sentence_id": "S058",
            "quote": "We believe in human resources."
          },
          {
            "sentence_id": "S059",
            "quote": "Any development planning for the region that ignores Syria would be flawed, and the price would be heavy."
          },
          {
            "sentence_id": "S060",
            "quote": "Ladies and gentlemen, these initiatives focus on the recovery of citizens in Syria."
          },
          {
            "sentence_id": "S061",
            "quote": "This is why we focused on safe and dignified return."
          },
          {
            "sentence_id": "S062",
            "quote": "We launched the initiative “Syria Without Refugee Camps” to end this era."
          }
        ]
      },
      {
        "label": "Israel and Golan",
        "text": "Reaffirmed Syria’s claim to the Golan under Security Council resolution 497 and commitment to the 1974 agreement. Condemned Israeli strikes and incursions and demanded withdrawal to the lines of 8 December 2024.",
        "evidence": [
          {
            "sentence_id": "S067",
            "quote": "The Golan will remain Syrian territory."
          },
          {
            "sentence_id": "S068",
            "quote": "Any other attempts will be thwarted according to Security Council Resolution 497."
          },
          {
            "sentence_id": "S069",
            "quote": "I thank all those who abided by international law, and I thank those who refrained from reinterpreting Resolution 497."
          },
          {
            "sentence_id": "S070",
            "quote": "This resolution is clear, and I ask our partners to abide by international law and by this resolution."
          },
          {
            "sentence_id": "S071",
            "quote": "The world is joyful about our return, but Israel is launching attacks against Syria."
          },
          {
            "sentence_id": "S072",
            "quote": "There have been 500 airstrikes, more than 1,200 incursions, and 300 detentions."
          },
          {
            "sentence_id": "S073",
            "quote": "This is at odds with the orientation we are seeing at the global level."
          },
          {
            "sentence_id": "S074",
            "quote": "It is reminiscent of an era that we thought was long gone."
          },
          {
            "sentence_id": "S075",
            "quote": "We are committed to the 1974 agreement."
          },
          {
            "sentence_id": "S076",
            "quote": "We call for the withdrawal of Israeli forces to the lines of 8 December 2024."
          },
          {
            "sentence_id": "S077",
            "quote": "We reject Israeli attempts to impose a fait accompli."
          },
          {
            "sentence_id": "S078",
            "quote": "We reject their aggressions, which undermine peace and security."
          }
        ]
      }
