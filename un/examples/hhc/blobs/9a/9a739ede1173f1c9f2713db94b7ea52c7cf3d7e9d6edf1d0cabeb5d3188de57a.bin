  "ROU": {
    "bullets": [
      {
        "label": "Ukraine and regional defense",
        "text": "Pledged continued support for Ukraine and Moldova, citing refugee assistance, grain transit, Black Sea mine countermeasures, a maritime-security hub with Bulgaria, and energy interconnections. Supported a 5%-of-GDP defense-spending target and reported 3.7% for 2026.",
        "evidence": [
          {
            "sentence_id": "S025",
            "quote": "Ladies and gentlemen, we have entered the fifth year of the illegal, unprovoked, and unjustified full-scale war of aggression against Ukraine waged by a permanent member of the Security Council."
          },
          {
            "sentence_id": "S026",
            "quote": "This member, entrusted by the entire UN community with the responsibility of maintaining international peace and security, has deliberately disavowed its fundamental obligation and is pursuing a revisionist agenda."
          },
          {
            "sentence_id": "S027",
            "quote": "As the EU member state sharing the longest border with Ukraine, Romania has felt the effects of this war directly through repeated violations of our airspace."
          },
          {
            "sentence_id": "S028",
            "quote": "A few months back, a drone crashed into a residential building on our territory, injuring people and causing material damage."
          },
          {
            "sentence_id": "S029",
            "quote": "It was one episode in an ongoing series of such incidents."
          },
          {
            "sentence_id": "S030",
            "quote": "We have said it before, and we will say it again: Romania will stand with Ukraine and its people as they exercise their legitimate right to self-defense for as long as necessary."
          },
          {
            "sentence_id": "S031",
            "quote": "Moreover, Romania is acting responsibly to stabilize the region."
          },
          {
            "sentence_id": "S032",
            "quote": "We provided assistance to refugees from Ukraine."
          },
          {
            "sentence_id": "S033",
            "quote": "In response to Russia's attacks on ports and grain infrastructure, which disrupted global food supply chains and deepened food insecurity for millions of people, Romania has coordinated with Ukraine on the transit of grain through Romania by rail and by waterway."
          },
          {
            "sentence_id": "S034",
            "quote": "In response to the disruption of freedom of navigation in the Black Sea, together with Bulgaria and Turkey, Romania is part of the mine countermeasures task group in the Black Sea, through mine detection and mine neutralization missions and the protection of critical undersea infrastructure."
          },
          {
            "sentence_id": "S035",
            "quote": "This initiative safeguards freedom of navigation and the region's energy security."
          },
          {
            "sentence_id": "S036",
            "quote": "In order to enhance security in the Black Sea area, Romania places particular emphasis on the EU strategic approach."
          },
          {
            "sentence_id": "S037",
            "quote": "Accordingly, together with Bulgaria, we are establishing a maritime security hub aimed at strengthening situational awareness."
          },
          {
            "sentence_id": "S038",
            "quote": "Finally, in response to disruptions to energy supplies in the region, Romania has expanded its energy interconnections with Ukraine and the Republic of Moldova."
          },
          {
            "sentence_id": "S039",
            "quote": "Romania will continue to support the resilience of our neighbor, the Republic of Moldova, the second most affected country by this war."
          },
          {
            "sentence_id": "S040",
            "quote": "It is facing the economic shock caused by Russia's aggression and a sustained hybrid campaign consisting of disseminating disinformation, energy pressure, and attempts to destabilize its democratic institutions."
          },
          {
            "sentence_id": "S041",
            "quote": "Romania is a staunch supporter of the Republic of Moldova in the face of these challenges."
          },
          {
            "sentence_id": "S042",
            "quote": "Romania also remains the Republic of Moldova's strongest advocate within the European Union, sharing our own experience of accession and providing political, technical, and diplomatic support for its European path."
          },
          {
            "sentence_id": "S043",
            "quote": "The threat posed by the Russian Federation is not limited to Ukraine."
          },
          {
            "sentence_id": "S044",
            "quote": "Europe is the target of a hybrid war involving cyberattacks, disinformation campaigns, sabotage, and disruptions to critical infrastructure, with the aim of undermining citizens' trust in democratic institutions and discouraging support for Ukraine."
          },
          {
            "sentence_id": "S045",
            "quote": "We must deter the Russian threat, and unfortunately, we can only do that by increasing military spending."
          },
          {
            "sentence_id": "S046",
            "quote": "Romania supports increasing military expenditure to a target of 5% of GDP, reaching this year 3.7%."
          }
        ]
      },
      {
        "label": "Middle East and navigation",
        "text": "Supported full implementation of President Trump’s Gaza plan and the Board of Peace initiative, humanitarian evacuations, and Hamas disarmament. Called for a verifiable diplomatic agreement preventing Iranian nuclear weapons and unrestricted navigation through Hormuz and the Black Sea.",
        "evidence": [
          {
            "sentence_id": "S047",
            "quote": "Distinguished audience, we are equally concerned about the proliferation of conflicts worldwide."
          },
          {
            "sentence_id": "S048",
            "quote": "It is essential to advance the implementation of the peace plan for Gaza in accordance with Security Council Resolution 2803 and to address, without delay, the humanitarian situation on the ground."
          },
          {
            "sentence_id": "S049",
            "quote": "Within the Board of Peace Initiative, Romania has offered its support and has so far contributed to the medical evacuation of numerous patients, especially children."
          },
          {
            "sentence_id": "S050",
            "quote": "Disarming Hamas remains a prerequisite condition for lasting stability in Gaza."
          },
          {
            "sentence_id": "S051",
            "quote": "President Trump's peace plan represents the most credible path toward peace and prosperity in the region, and Romania supports its full implementation."
          },
          {
            "sentence_id": "S052",
            "quote": "At the same time, recent developments in the West Bank are a genuine reason for concern and risk undermining the peace that this plan seeks to promote."
          },
          {
            "sentence_id": "S053",
            "quote": "Regarding Iran, our position is clear: Iran must not possess a nuclear weapon."
          },
          {
            "sentence_id": "S054",
            "quote": "Iran must comply with the Nuclear Non-Proliferation Treaty, the safeguards of the International Atomic Energy Agency, and restore full transparency regarding its nuclear program."
          },
          {
            "sentence_id": "S055",
            "quote": "Diplomacy must be the first option toward a comprehensive, verifiable, and lasting agreement that would pave the way toward a more stable Middle East."
          },
          {
            "sentence_id": "S056",
            "quote": "Romania will continue to promote maritime security and unrestricted freedom of navigation in the Strait of Hormuz, as well as in the Black Sea area and elsewhere."
          },
          {
            "sentence_id": "S057",
            "quote": "It is a shared responsibility and a priority to my country."
          },
          {
            "sentence_id": "S058",
            "quote": "Specialized bodies such as the International Maritime Organization can make a contribution to this effort."
          },
          {
            "sentence_id": "S059",
            "quote": "The suspension of the Black Sea Grain Initiative following Russia's unilateral withdrawal in 2023 reminds us that agreements only matter when the parties honor their commitments."
          }
        ]
      },
      {
        "label": "Democracy and investment",
        "text": "Warned that coordinated fake social-media accounts undermine individual expression and association. Promoted investment in Romanian technology, manufacturing, energy, and critical resources, including planned Black Sea gas production beginning in 2027.",
        "evidence": [
          {
            "sentence_id": "S005",
            "quote": "But let me first draw your attention to a threat to our democracies that I do not believe is receiving the interest it deserves: manipulation via social media."
          },
          {
            "sentence_id": "S006",
            "quote": "The fundamental principle of democracy is one person, one voice, one vote."
          },
          {
            "sentence_id": "S007",
            "quote": "But if thousands of fake accounts speak in a coordinated manner, the individual voice is no longer heard, and freedom of speech is denied."
          },
          {
            "sentence_id": "S008",
            "quote": "And if thousands of fake accounts launch a coordinated attack on the ideas expressed by an individual, they discourage others from joining that person's cause, and freedom of association is denied."
          },
          {
            "sentence_id": "S009",
            "quote": "The same principles that underpin international law, human rights, the rule of law, and democratic governance are the principles that helped transform my country."
          },
          {
            "sentence_id": "S010",
            "quote": "Romania's evolution over the past 37 years proves the crucial importance of upholding these principles."
          },
          {
            "sentence_id": "S011",
            "quote": "Millions of Romanians know from their personal experience the difference between a communist system that oppressed them and stifled their initiative and freedom of choice, and a democracy that rewards work, innovation, and personal responsibility."
          },
          {
            "sentence_id": "S012",
            "quote": "This choice has turned Romania into one of Europe's most dynamic destinations for investment and industrial development."
          },
          {
            "sentence_id": "S013",
            "quote": "Romania has aligned itself with the standards of the OECD."
          },
          {
            "sentence_id": "S014",
            "quote": "Leading global companies have established manufacturing, engineering, technology, and service centers in my country, attracted by our conducive business environment and highly skilled workforce."
          },
          {
            "sentence_id": "S015",
            "quote": "Our most important strategic asset is our people."
          },
          {
            "sentence_id": "S016",
            "quote": "Romanian scientists, engineers, physicians, and technology specialists are shaping the industries of the future: artificial intelligence, cybersecurity, defense technologies, advanced manufacturing, and robotics."
          },
          {
            "sentence_id": "S017",
            "quote": "Moreover, Romania is strengthening Europe's resilience."
          },
          {
            "sentence_id": "S018",
            "quote": "We are developing significant reserves of natural gas, critical minerals, and other strategic resources, essential for securing supply chains and reducing dependence on unpredictable energy sources."
          },
          {
            "sentence_id": "S019",
            "quote": "Next year, we will begin extracting and exploiting 100 billion cubic meters of natural gas in the Black Sea."
          },
          {
            "sentence_id": "S020",
            "quote": "Romania is a gateway between Europe and the rest of the world, located at the intersection of the Danube, the Black Sea, and major trade corridors."
          },
          {
            "sentence_id": "S021",
            "quote": "My country serves as a strategic hub for trade, energy, and transport."
          },
          {
            "sentence_id": "S022",
            "quote": "Economic growth is all the stronger when it is based on partnership."
          },
          {
            "sentence_id": "S023",
            "quote": "Our message is simple: Romania is open to business and innovation."
          },
          {
            "sentence_id": "S024",
            "quote": "We are a credible and reliable partner, ready to contribute to shared prosperity."
          }
        ]
      },
      {
        "label": "UN and Francophonie engagement",
        "text": "Supported African-led peace efforts and peacekeeping with clear mandates, measurable results, and responsible financing. Sought support for Romania’s OIF Secretary-General candidate and highlighted participation in international initiatives for children’s education and safety.",
        "evidence": [
          {
            "sentence_id": "S060",
            "quote": "We support lasting peace in Sudan, South Sudan, the Democratic Republic of the Congo, Somalia, Libya, the Sahel, and in all regions of Africa affected by conflict."
          },
          {
            "sentence_id": "S061",
            "quote": "Romania is contributing to conflict prevention, mediation, peacebuilding, and economic recovery while stressing the importance of African solutions and full respect for the Charter."
          },
          {
            "sentence_id": "S062",
            "quote": "Prevention and mediation must play a greater role."
          },
          {
            "sentence_id": "S063",
            "quote": "Peacekeeping operations must have a clear mandate, produce measurable results, ensure responsible financing, and equitably distribute responsibilities."
          },
          {
            "sentence_id": "S064",
            "quote": "Since 1991, Romania has contributed to United Nations peacekeeping missions through political support, troop and equipment contributions, as well as through training blue helmets and close protection officers."
          },
          {
            "sentence_id": "S065",
            "quote": "Romania also attaches great importance to the role of the International Organisation of La Francophonie in promoting peace and security."
          },
          {
            "sentence_id": "S066",
            "quote": "With the majority of its 90 members located in Africa, the OIF supports mediation, electoral monitoring, and peacebuilding in fragile contexts."
          },
          {
            "sentence_id": "S067",
            "quote": "Romania presented a candidate for the post of Secretary-General of the OIF, a former prime minister and a prominent, experienced figure in international affairs."
          },
          {
            "sentence_id": "S068",
            "quote": "This candidature reflects Romania's will to put its experience at the service of La Francophonie, making it stronger and more efficient."
          },
          {
            "sentence_id": "S069",
            "quote": "We count on your support."
          },
          {
            "sentence_id": "S070",
            "quote": "Ladies and gentlemen, allow me to conclude by welcoming the initiatives of the First Ladies and First Gentlemen concerning children and education, innovation, digital education, and children's safety."
          },
          {
            "sentence_id": "S071",
            "quote": "Romania has joined the initiatives launched by Melania Trump, Emine Erdoğan, and Olena Zelenska."
          },
          {
            "sentence_id": "S072",
            "quote": "By building accessible education and creating a more innovative and safer environment for our children, we are building a better future for our societies."
          }
        ]
      }
