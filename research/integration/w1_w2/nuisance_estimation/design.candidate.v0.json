    "fixed_effects": [
      "intercept",
      "genre_binary",
      "language_binary",
      "role_binary",
      "length_standardized",
      "agenda_one_hot_1",
      "agenda_one_hot_2"
    ],
    "covariance_components": [
      "meeting_random_intercept_variance",
      "recorded_affiliation_random_intercept_variance",
      "year_AR1_stationary_variance",
      "independent_observation_residual_variance",
      "year_AR1_rho"
    ],
    "covariance_formula": "V_ij = vm*[m_i=m_j] + va*[a_i=a_j] + vy*rho^abs(year_i-year_j) + ve*[i=j]",
    "parameter_inference": "All five covariance parameters estimated from synthetic training response and X; never pass generating variances or rho into estimator",
    "variance_parameterization": "log variances relative to empirical response scale, nonnegative bounded; rho=tanh(unconstrained)*0.85",
    "optimizer": "deterministic multi-start profile-like coordinate descent on restricted Gaussian likelihood with Cholesky",
    "missingness_model": "conditional_on_declared_X_and_source_design_mask_only",
    "missing_not_at_random_handling": "WITHHELD_NOT_IDENTIFIED; no imputation, inverse-probability weights or false missing-at-random declaration",
    "conditioning": "The observed synthetic attendance/source mask is fixed. Unselected eligible and unavailable source statuses remain separate.",
    "year_count_scientific_minimum_candidate": 16,
    "year_count_engineering_preflight_minimum": 12,
    "meetings_per_year_minimum": 2,
