    "minimum_per_meeting_selected": 2,
    "source_family_cross_meetings": "fail_closed",
    "time_gaps": "explicit integer year indices; do not relabel gaps as adjacent or infer AR1 from row order",
    "uncertainty": "No SE/CI/pvalue claimed; profile curvature, boundary, optimizer stability and condition numbers are diagnostics only"
  },
