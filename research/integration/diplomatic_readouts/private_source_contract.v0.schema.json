            "un.latent-comparison.v1",
            "un.passage-corpus.v1",
            "un.review.v1"
          ]
        },
        "source_hash_basis": {
          "enum": [
            "canonical_source_text",
            "raw_response_bytes",
            "source_text_file_bytes",
            "synthetic",
            "utf8_corpus_export",
            "utf8_response_text"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "envelope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
