                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "configuration_id": {
                  "type": "string",
                  "minLength": 1
                },
                "resample_type": {
                  "enum": [
                    "baseline",
                    "leave_group_out",
                    "group_bootstrap"
                  ]
