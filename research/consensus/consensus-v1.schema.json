          "source_group_count": {
            "type": "integer",
            "minimum": 0
          },
          "max_source_group_share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minimum_pair_association": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "source_restricted_groups": {
      "type": "array",
