  "required": [
    "schema",
    "version",
    "contract_schema",
    "evaluation_role",
    "publication_eligible",
    "source",
    "observation_ids",
    "matrix",
    "pairs",
    "family_weight_audit",
    "uncertainty",
    "reproducible_groups",
    "source_restricted_groups",
    "ambiguous_members",
    "ungrouped_observations",
    "unsupported_pair_ledger",
    "thresholds",
    "sensitivity_report",
    "individual_method_comparisons",
    "limitations"
  ],
