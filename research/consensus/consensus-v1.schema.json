{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/un-consensus-v1",
  "title": "Source-bound hard-assignment consensus sidecar v1",
  "description": "Synthetic/development-only. Association is descriptive conditional co-assignment, never diplomatic agreement or inferential significance.",
