              "id": {
                "type": "string",
                "minLength": 1
              },
              "text_sha256": {
                "type": "string",
                "minLength": 1
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "meeting_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "json_pointer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "start": {
                "type": [
                  "integer",
                  "null"
