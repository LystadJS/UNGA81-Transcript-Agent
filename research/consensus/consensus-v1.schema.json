        "source_hash_basis": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "frame_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "corpus_sha256": {
          "type": [
            "string",
            "null"
          ]
