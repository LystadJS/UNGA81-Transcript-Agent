            "type": "integer",
            "minimum": 0
          },
          "internal_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "internal_failures": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "model_id",
                "method",
                "configuration_id",
                "resample_type",
                "resample_id",
                "seed",
                "planned_weight",
                "fitted_observations",
                "source_group_sample",
                "fitting_success"
