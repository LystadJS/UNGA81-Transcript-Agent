    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_a",
          "observation_b",
          "coassigned_count",
          "assigned_both_count",
          "planned_count",
          "missing_pair_count",
          "noise_pair_count",
          "different_cluster_count",
          "failed_fit_count",
          "coassigned_weight",
          "assigned_both_weight",
          "planned_weight",
          "association",
