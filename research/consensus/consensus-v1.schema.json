            "properties": {
              "observation_a": {
                "type": "string",
                "minLength": 1
              },
              "observation_b": {
                "type": "string",
                "minLength": 1
              },
              "leave_group_out": {
                "type": "object"
              },
              "group_bootstrap": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
