{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LystadJS/UNGA81-Transcript-Agent/blob/main/research/validation_framework/schemas/historical-link.candidate.v0.schema.json",
  "title": "W1 Historical Inventory Link: engineering-only coordinator review candidate",
  "description": "Aggregate-only correspondence for an already validated standalone source-inventory v1 sidecar and a W1 source-selected fit. This is NOT a parallel-analysis v2 release contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter_version",
    "fixture_kind",
    "publication_eligible",
    "evaluation_role",
    "contract_status",
    "legacy_interchange_v1",
    "upstream",
    "coverage",
    "models",
    "group_refits",
    "comparison_count",
    "failure_ledger_count",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "un.w1-historical-inventory-link.candidate.v0"
    },
    "adapter_version": {
      "const": "0.1.0"
    },
    "fixture_kind": {
      "enum": [
        "synthetic",
        "private_development"
      ]
    },
    "publication_eligible": {
      "const": false
    },
    "evaluation_role": {
      "const": "engineering_only"
    },
    "contract_status": {
      "const": "coordinator_review_required"
    },
    "legacy_interchange_v1": {
      "const": "withheld"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_schema",
        "source_engine",
        "original_source_hash_basis",
        "original_source_sha256",
        "full_inventory_sha256",
        "inventory_selection_sha256",
        "w1_selection_sha256",
        "w1_population_sha256"
      ],
      "properties": {
        "source_schema": {
          "type": "string",
          "minLength": 1
        },
        "source_engine": {
          "type": "string",
          "minLength": 1
        },
        "original_source_hash_basis": {
          "type": "string",
          "minLength": 1
        },
        "original_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "full_inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inventory_selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "w1_selection_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "w1_population_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_total",
        "verified_available",
        "unverified",
        "other_missing",
        "w1_frame_total",
        "w1_selected_fit_eligible",
        "w1_excluded_in_frame",
        "verified_explicitly_excluded_in_frame",
        "verified_not_selected",
        "never_interpret_unverified_as_zero",
        "unselected_reason"
      ],
      "properties": {
        "inventory_total": {
          "type": "integer",
          "minimum": 0
        },
        "verified_available": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "other_missing": {
          "type": "integer",
          "minimum": 0
        },
        "w1_frame_total": {
          "type": "integer",
          "minimum": 0
        },
        "w1_selected_fit_eligible": {
          "type": "integer",
          "minimum": 0
        },
        "w1_excluded_in_frame": {
          "type": "integer",
          "minimum": 0
        },
        "verified_explicitly_excluded_in_frame": {
          "type": "integer",
          "minimum": 0
        },
        "verified_not_selected": {
          "type": "integer",
          "minimum": 0
        },
        "never_interpret_unverified_as_zero": {
          "const": true
        },
        "unselected_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "method",
          "representation_id",
          "representation_version",
          "status",
          "full_attempted",
          "full_successful",
          "full_failed",
          "assigned",
          "unassigned_noise",
          "selected_but_not_fitted"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "kmeans",
              "pam",
              "hierarchical",
              "gmm",
              "hdbscan"
            ]
          },
          "representation_id": {
            "type": "string",
            "minLength": 1
          },
          "representation_version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "fitted",
              "skipped",
              "failed"
            ]
          },
          "full_attempted": {
            "type": "integer",
            "minimum": 0
          },
          "full_successful": {
            "type": "integer",
            "minimum": 0
          },
          "full_failed": {
            "type": "integer",
            "minimum": 0
          },
          "assigned": {
            "type": "integer",
            "minimum": 0
          },
          "unassigned_noise": {
            "type": "integer",
            "minimum": 0
          },
          "selected_but_not_fitted": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "group_refits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "unit",
          "planned",
          "executed",
          "successful",
          "failed",
          "skipped",
          "assessable_ari",
          "independent_source_replication",
          "inferential_uncertainty"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "enum": [
              "meeting",
              "affiliation"
            ]
          },
          "planned": {
            "type": "integer",
            "minimum": 0
          },
          "executed": {
            "type": "integer",
            "minimum": 0
          },
          "successful": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "assessable_ari": {
            "type": "integer",
            "minimum": 0
          },
          "independent_source_replication": {
            "const": false
          },
          "inferential_uncertainty": {
            "const": "withheld"
          }
        }
      }
    },
    "comparison_count": {
      "type": "integer",
      "minimum": 0
    },
    "failure_ledger_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
