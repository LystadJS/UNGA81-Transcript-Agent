{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LystadJS/UNGA81-Transcript-Agent/blob/main/docs/parallel-work/interchange-v1.schema.json",
  "title": "UNGA81 development-only parallel analytical interchange v1",
  "description": "Derived source-linked analysis metadata only. Public repository must not receive transcript-derived observation-level outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "producer",
    "upstream",
    "cohort",
    "observations",
    "models",
    "results",
    "coverage",
    "evidence",
    "diagnostics",
    "limitations",
    "publication_eligible",
    "evaluation_role"
  ],
  "properties": {
    "schema": {
      "const": "un.parallel-analysis.v1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "producer": {
      "type": "object",
      "required": [
        "workstream_id",
        "adapter_version",
        "code_sha256",
        "runtime",
        "generated_at",
        "fixture_kind"
      ],
      "properties": {
        "workstream_id": {
          "enum": [
            "W1",
            "W2",
            "W3",
            "W4",
            "W5",
            "W6",
            "W7"
          ]
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "fixture_kind": {
          "enum": [
            "synthetic",
            "private_development"
          ]
        }
      },
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "required": [
        "source_schema",
        "source_engine",
        "source_hash_basis",
        "source_sha256",
        "frame_sha256",
        "corpus_sha256",
        "selection_sha256",
        "review_sha256",
        "missing_reason"
      ],
      "properties": {
        "source_schema": {
          "enum": [
            "un.browser.corpus.v1",
            "un.latent-comparison.v1",
            "un.passage-corpus.v1",
            "un.review.v1",
            "synthetic.v1"
          ]
        },
        "source_engine": {
          "type": "string",
          "minLength": 1
        },
        "source_hash_basis": {
          "enum": [
            "utf8_corpus_export",
            "raw_response_bytes",
            "utf8_response_text",
            "canonical_source_text",
            "source_text_file_bytes",
            "synthetic"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "frame_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cohort": {
      "type": "object",
      "required": [
        "split",
        "population",
        "unit",
        "selection_policy",
        "weighting",
        "source_group_unit",
        "duplicate_policy",
        "total_in_frame",
        "eligible"
      ],
      "properties": {
        "split": {
          "enum": [
            "development",
            "synthetic"
          ]
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "enum": [
            "source_segment",
            "passage",
            "reviewed_speech",
            "parent",
            "country_period",
            "synthetic"
          ]
        },
        "selection_policy": {
          "type": "string",
          "minLength": 1
        },
        "weighting": {
          "enum": [
            "equal_passage",
            "equal_meeting",
            "equal_speech",
            "equal_country",
            "none"
          ]
        },
        "source_group_unit": {
          "enum": [
            "meeting",
            "speech",
            "parent",
            "country",
            "source_family",
            "synthetic"
          ]
        },
        "duplicate_policy": {
          "type": "string",
          "minLength": 1
        },
        "total_in_frame": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text_sha256",
          "parent_id",
          "parent_text_sha256",
          "meeting_id",
          "speech_id",
          "source_family_id",
          "date",
          "country",
          "source_url",
          "json_pointer",
          "start",
          "end",
          "unit",
          "review_status",
          "exclusion_reasons",
          "source_status",
          "missing_reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_text_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "meeting_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "speech_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_family_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "json_pointer": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "end": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "enum": [
              "source_segment",
              "passage",
              "reviewed_speech",
              "parent",
              "country_period",
              "synthetic"
            ]
          },
          "review_status": {
            "enum": [
              "confirmed",
              "pending",
              "provisional",
              "unreviewed",
              "not_applicable"
            ]
          },
          "exclusion_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_status": {
            "enum": [
              "available",
              "unavailable",
              "failed",
              "excluded_language",
              "empty_transcript",
              "inventory_failed"
            ]
          },
          "missing_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "method_family",
          "method",
          "representation_id",
          "representation_version",
          "fit_version",
          "fit_split",
          "parameters_sha256",
          "training_selection_sha256",
          "diagnostic_basis"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "method_family": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "representation_id": {
            "type": "string",
            "minLength": 1
          },
          "representation_version": {
            "type": "string",
            "minLength": 1
          },
          "fit_version": {
            "type": "string",
            "minLength": 1
          },
          "fit_split": {
            "enum": [
              "development",
              "synthetic"
            ]
          },
          "parameters_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "training_selection_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "diagnostic_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "observation_id",
          "status",
          "cluster",
          "membership_kind",
          "memberships",
          "membership_strength",
          "representation_basis_id",
          "reason"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "assigned",
              "unassigned",
              "not_fitted",
              "excluded"
            ]
          },
          "cluster": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "membership_kind": {
            "enum": [
              "gmm_responsibility",
              "nmf_share",
              "hdbscan_strength",
              "consensus_frequency",
              "none"
            ]
          },
          "memberships": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "membership_strength": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "representation_basis_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "inventory_meetings",
        "observations_total",
        "eligible",
        "excluded",
        "unavailable_sources",
        "models",
        "failure_ledger"
      ],
      "properties": {
        "inventory_meetings": {
          "type": "integer",
          "minimum": 0
        },
        "observations_total": {
          "type": "integer",
          "minimum": 0
        },
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_sources": {
          "type": "integer",
          "minimum": 0
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model_id",
              "eligible",
              "assigned",
              "unassigned",
              "not_fitted",
              "excluded",
              "attempted_fits",
              "successful_fits",
              "failed_fits"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "eligible": {
                "type": "integer",
                "minimum": 0
              },
              "assigned": {
                "type": "integer",
                "minimum": 0
              },
              "unassigned": {
                "type": "integer",
                "minimum": 0
              },
              "not_fitted": {
                "type": "integer",
                "minimum": 0
              },
              "excluded": {
                "type": "integer",
                "minimum": 0
              },
              "attempted_fits": {
                "type": "integer",
                "minimum": 0
              },
              "successful_fits": {
                "type": "integer",
                "minimum": 0
              },
              "failed_fits": {
                "type": "integer",
                "minimum": 0
              },
              "skipped_fits": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "failure_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model_id",
              "attempt",
              "status",
              "reason"
            ],
            "properties": {
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "failed",
                  "skipped",
                  "timed_out",
                  "nonconverged"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "source_group": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "source_url",
          "json_pointer",
          "start",
          "end",
          "role",
          "proposition_id",
          "verification"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "json_pointer": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "end": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "role": {
            "enum": [
              "representative",
              "contrary",
              "ambiguous",
              "context"
            ]
          },
          "proposition_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "enum": [
              "source_linked",
              "provisional",
              "human_confirmed",
              "unresolved",
              "synthetic"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "name",
          "value",
          "denominator",
          "unit",
          "status",
          "reason"
        ],
        "properties": {
          "model_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "denominator": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "descriptive",
              "validated",
              "withheld",
              "inconclusive",
              "failed",
              "not_run"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "scope",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "publication_eligible": {
      "const": false
    },
    "evaluation_role": {
      "const": "engineering_only"
    }
  }
}
